{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ub",
  "version": "0.1.0",
  "identifier": "com.skye.ub",
  "build": {
    "beforeDevCommand": "npm run dev:react",
    "devUrl": "http://localhost:4043",
    "beforeBuildCommand": "npm run type-check",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "../src/assets/loading.html",
        "width": 400,
        "height": 300,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": false,
        "visible": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "UBookDesktop",
        "url": "../index.html",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "$APPDATA/**", "$HOME/.UBookDesk/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
