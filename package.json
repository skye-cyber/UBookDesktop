{
  "name": "ubookdesktop",
  "version": "1.3.2",
  "description": "An application providing urantia book content.",
  "main": "src/main/index.js",
  "homepage": "src/renderer/home.html",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1",
    "tailwind:build": "NODE_ENV=production npx tailwindcss -i ./src/renderer/css/config.css -o ./src/renderer/css/styles.css --minify",
    "tailwind:watch": "npx tailwindcss -i ./src/renderer/css/config.css -o ./src/renderer/css/styles.css --watch",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "electron .",
    "build": "npm run build:react && sudo npm run build:electron",
    "build:react": "vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview",
    "package": "electron-packager .",
    "forge": "electron-forge package",
    "generate:linux-icons": "node src/scripts/generate-linux-icons.js",
    "postinstall": "node src/scripts/post-install.js"
  },
  "keywords": [
    "Urantia",
    "Urantia Book",
    "Revelation",
    "Philosophy",
    "Religion",
    "Science"
  ],
  "author": {
    "name": "Wambua Mwikya aka Skye",
    "email": "swskye17@gmail.com"
  },
  "license": "GNU",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "audit": "^0.0.6",
    "concurrently": "^9.2.1",
    "electron": "latest",
    "electron-builder": "latest",
    "fix": "^0.0.6",
    "sharp": "^0.30.7"
  },
  "dependencies": {
    "@babel/core": "latest",
    "@fiahfy/icns": "^0.0.7",
    "@tailwindcss/typography": "latest",
    "@vitejs/plugin-react": "^5.1.2",
    "assert": "^2.1.0",
    "base": "^3.0.0",
    "bl": "^6.0.16",
    "braces": "^3.0.3",
    "browser": "^0.2.6",
    "browserify-fs": "^1.0.0",
    "browserify-zlib": "^0.2.0",
    "child_process": "^1.0.2",
    "child-process-promise": "latest",
    "fs": "latest",
    "https-browserify": "^1.0.0",
    "lunr": "^2.3.9",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "play-sound": "^1.1.6",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.4",
    "vite": "^7.1.12",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vm-browserify": "^1.1.2"
  },
  "files": [
    "README.md",
    "LICENSE",
    "package.json",
    "build/**/*",
    "src/renderer/**/*",
    "src/main/**/*",
    "public/**/*",
    "!node_modules/",
    "!.eproj",
    "!icons"
  ],
  "build": {
    "appId": "com.ubookdesktop.app",
    "productName": "UBookDesktop",
    "electronDownload": {
      "cache": true
    },
    "asar": true,
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "src/assets/",
        "to": "assets/"
      },
      {
        "from": "build/",
        "to": "build/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/common/",
        "to": "common/"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/ubookdesktop.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "identity": null
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.dmg"
    },
    "win": {
      "icon": "src/assets/ubookdesktop.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "artifactName": "${productName}-${version}-${arch}.${ext}"

    },
    "portable": {
      "artifactName": "${productName}-portable-${version}-${arch}.${ext}"
    },
    "msi": {
      "artifactName": "${productName}-portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "armv7l",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "src/icons",
      "maintainer": "Mwikya -- swskye17@gmail.com",
      "synopsis": "UBookDesktop",
      "description": "Read Urantia Book on Your Desktop (favourite, bookmark, search, save notes)"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.AppImage"
    },
    "deb": {
      "priority": "optional",
      "artifactName": "${productName}_${version}_${arch}.deb"
    },
    "snap": {
      "summary": "UBookDesktop Snap Package",
      "grade": "stable",
      "confinement": "classic",
      "plugs": [
        "network",
        "home",
        "audio-playback"
      ],
      "artifactName": "${productName}_${version}_${arch}.snap"
    }
  }
}
