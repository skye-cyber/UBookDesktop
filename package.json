{
  "name": "ubook",
  "version": "1.3.3",
  "description": "An application providing urantia book content.",
  "private": "true",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:react": "vite",
    "dev:types": "tsc --noEmit --watch",
    "dev:styles": "tailwindcss -i ./src/styles/config.css -o ./src/styles/index.css --watch",
    "dev:common": "tsc -p tsconfig.common.json --watch",
    "dev:tauri": "tauri dev",
    "build": "npm run clean && npm run type-check && npm run build:all",
    "build:all": "npm-run-all build:common build:react build:tauri",
    "build:common": "tsc -p tsconfig.common.json",
    "build:react": "vite build",
    "build:tauri": "tauri build",
    "package": "npm run build",
    "clean": "rimraf dist",
    "type-check": "tsc -p tsconfig.common.json --noEmit",
    "styles": "tailwindcss -i ./src/styles/config.css -o ./src/styles/index.css",
    "tauri": "tauri"
  },
  "keywords": [
    "Urantia",
    "Urantia Book",
    "Revelation",
    "Philosophy",
    "Religion",
    "Science"
  ],
  "author": {
    "name": "Wambua Mwikya aka Skye",
    "email": "swskye17@gmail.com"
  },
  "license": "GNU",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-store": "^2.4.5",
    "lunr": "^2.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
